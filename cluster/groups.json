{
  "about": "The cluster's area groups (X72), read by report/cluster_breakdown.py. A node of DC's area_hierarchy.rpt (its instance path under the top, '/' between levels) belongs to the first group with a rule it matches (each regex fully, `design` against its design name); a node no rule matches belongs to its parent's group, the top to `others`. A node's own area (its total minus its children's) goes to its group, so the groups add up to the total. `hwcost` maps snax-forge's five parts (D167) to the groups that hold them; every other group is something HWCOST does not cost.",
  "groups": [
    {"name": "tcdm_banks", "label": "TCDM banks (macros)",
     "rules": [{"path": "i_cluster/i_snitch_data_mem/.*", "design": "tc_sram_impl_.*"}]},
    {"name": "icache_macros", "label": "I-cache macros (data and tag)",
     "rules": [{"path": "i_cluster/gen_hive\\[\\d+\\]\\.i_snitch_hive/.*", "design": "tc_sram_impl_.*"}]},
    {"name": "acc_datapath", "label": "accelerator datapath",
     "rules": [{"path": "i_snax_core_\\d+_acc_\\d+_\\w+/i_\\w+_shell_wrapper/dp"}]},
    {"name": "acc_control", "label": "accelerator control",
     "rules": [{"path": "i_snax_core_\\d+_acc_\\d+_\\w+/i_\\w+_shell_wrapper/ctrl"}]},
    {"name": "acc_csr", "label": "accelerator csr (with its peripherals)",
     "rules": [{"path": "i_snax_core_\\d+_acc_\\d+_\\w+/i_\\w+_shell_wrapper/csr"}]},
    {"name": "streamers", "label": "streamers",
     "rules": [{"path": "i_snax_core_\\d+_acc_\\d+_\\w+/i_\\w+_streamer_wrapper"}]},
    {"name": "acc_interface", "label": "SNAX CSR path (the cores' translators, the accelerator wrapper's demux and glue)",
     "rules": [{"path": "i_snax_core_\\d+_acc_\\d+_\\w+"},
               {"path": "i_cluster/gen_snax_control_connection\\[\\d+\\]\\.[^/]*i_snax_intf_translator"}]},
    {"name": "tcdm_interconnect", "label": "TCDM sparse interconnect",
     "rules": [{"path": "i_cluster/gen_yes_snax_tcdm_interconnect\\.[^/]*/sparse_interconnect_i"}]},
    {"name": "tcdm_logic", "label": "TCDM bank logic (AMO shims, muxes)",
     "rules": [{"path": "i_cluster/gen_tcdm_super_bank\\[\\d+\\]\\.[^/]+"}]},
    {"name": "dma", "label": "DMA (iDMA, its AXI-to-memory and interconnect)",
     "rules": [{"path": "i_cluster/gen_core\\[\\d+\\]\\.i_snitch_cc/gen_dma\\.i_idma_inst64_top"},
               {"path": "i_cluster/i_axi_to_mem_dma"}, {"path": "i_cluster/i_dma_interconnect"}]},
    {"name": "cores", "label": "RISC-V cores (Snitch, with the shared mul/div)",
     "rules": [{"path": "i_cluster/gen_core\\[\\d+\\]\\.(i_snitch_cc|i_sync_\\w+)"},
               {"path": "i_cluster/gen_hive\\[\\d+\\]\\.i_snitch_hive/i_snitch_shared_muldiv"}]},
    {"name": "icache_logic", "label": "I-cache logic (the hive without its macros and mul/div)",
     "rules": [{"path": "i_cluster/gen_hive\\[\\d+\\]\\.i_snitch_hive"}]},
    {"name": "axi", "label": "AXI: the external cuts, both crossbars, the converters",
     "rules": [{"path": "i_cluster/i_cut_ext_\\w+"}, {"path": "i_cluster/i_cluster_xbar"},
               {"path": "i_cluster/i_axi_dma_xbar"}, {"path": "i_cluster/i_axi_to_(reg|tcdm)"},
               {"path": "i_cluster/i_reqrsp_(to_axi|mux)_core"}]},
    {"name": "peripherals", "label": "cluster peripherals (with the barrier)",
     "rules": [{"path": "i_cluster/i_snitch_cluster_peripheral"}, {"path": "i_cluster/i_snitch_barrier"},
               {"path": "i_cluster/i_popcount_\\w+"}]},
    {"name": "others", "label": "others (what no rule names)", "rules": []}
  ],
  "hwcost": {
    "datapath": ["acc_datapath"],
    "control": ["acc_control"],
    "streamers": ["streamers"],
    "crossbar": ["tcdm_interconnect"],
    "memory": ["tcdm_banks"]
  }
}
