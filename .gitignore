# Synthesis runs stay local (syn/README.md); only results/ is committed
syn/runs/
__pycache__/
*.pyc
# The pixi environment (pixi install); pixi.lock is committed
.pixi/
# Simulation and power runs stay local, as syn/runs/; the probe scripts are in sim/probe/
sim/runs/
# Generated RTL (forge/bundles.py writes rtl/forge/, char/blocks.py rtl/char/, strm/gen.py rtl/streamer/ and
# rtl/xbar/): never committed, a bundle is rebuilt from its commit
rtl/
# RAM1 runs stay local (R0: the OpenRAM probe, its lc_shell and DC runs); only numbers and notes are committed
ram/runs/
# CACTI's source and binary (pixi run ram-build); never committed
ram/cacti/
# arc/arc.py's temporary folders (unpacked zips, work folders), deleted after each step (X51)
tmp/
